# SmartCode environment configuration
# Copy to .env and fill in real values locally. NEVER commit .env.
# See docs/07-SECURITY-ARCHITECTURE.md and docs/08-DEPLOYMENT-ARCHITECTURE.md.

NODE_ENV=development
PORT=4000

# --- Database ---
POSTGRES_USER=smartcode
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smartcode
DATABASE_URL=postgresql://smartcode:changeme@localhost:5432/smartcode

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth (v1 native JWT - see docs/11-SCHEMA-DECISIONS.md) ---
JWT_ACCESS_SECRET=changeme_min_16_chars
JWT_REFRESH_SECRET=changeme_min_16_chars_different
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Keycloak (reserved - not active in v1, see docs/07-SECURITY-ARCHITECTURE.md) ---
KEYCLOAK_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# --- AWS (production target - see docs/08-DEPLOYMENT-ARCHITECTURE.md) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=smartcode-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Monitoring ---
SENTRY_DSN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# --- Seed script (optional; falls back to a dev-only default if unset) ---
SEED_MANAGER_PASSWORD=
