// SmartCode — Prisma schema
// Source of truth: docs/02-DATABASE-DESIGN.md, docs/11-SCHEMA-DECISIONS.md
// Phase 1 scope: full schema is defined now (per approved architecture),
// but Phase 1 only exercises User/Role/Team — Production/Audit business
// logic is implemented starting Phase 3/4.
//
// No JCD field exists anywhere in this schema. See docs/09-BUSINESS-RULES.md.
//
// LOCATION: this schema lives under apps/api/prisma/, not at the repo
// root. It was moved here during the Phase 1 Docker review - Prisma's
// client-resolution walks upward from the schema file's own directory,
// and a root-level prisma/ (a sibling of apps/api, not an ancestor of
// it) could never find @prisma/client, which only apps/api declares.
// apps/api/prisma/ IS a descendant of apps/api/, so the same upward
// walk now succeeds. See docker/api.Dockerfile's build stage comment
// for the full explanation.
//
// VERIFICATION STATUS (Phase 1 technical review): the Prisma CLI (generate/
// validate/format/migrate - every subcommand, including --help) could not
// run in the review sandbox because it unconditionally attempts to fetch
// its query/schema-engine binaries from binaries.prisma.sh on invocation,
// and that host was not reachable there. This file has therefore been
// verified MANUALLY, not by the Prisma compiler, against: syntax, every
// relation's field/reference pairing and cardinality, foreign-key presence
// and directionality (including the one deliberate exception - see
// AuditEntry.chartId below), index redundancy, enum-default validity,
// required/optional consistency between scalar FK fields and their
// relations, and datasource/generator config. See the root README.md's
// "Verifying this schema" section for the exact commands to run this
// through the real Prisma CLI (which will compiler-verify everything
// below) in an environment with normal internet access.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Identity & RBAC
// ─────────────────────────────────────────────────────────────

enum RoleName {
  MANAGER
  TEAM_LEAD
  CODER
  AUDITOR
  VENDOR
}

model User {
  id              String   @id @default(uuid())
  employeeId      String   @unique
  loginName       String   @unique
  email           String   @unique
  fullName        String?  // nullable to preserve existing seeded rows created before this field existed; required at the DTO level for all new user creation going forward
  passwordHash    String
  role            RoleName
  isActive        Boolean  @default(true)
  failedLoginCount Int     @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?

  // Reserved for future Keycloak migration — see docs/07-SECURITY-ARCHITECTURE.md.
  // Unused by v1 native-auth logic.
  externalId      String?
  authProvider    String   @default("local")

  createdById     String?
  createdBy       User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers    User[]   @relation("UserCreatedBy")

  teamId          String?
  team            Team?    @relation("TeamMembers", fields: [teamId], references: [id])
  leadsTeam       Team?    @relation("TeamLead")

  // For role VENDOR: the Vendor this login account belongs to.
  // For role CODER: the Vendor this Coder belongs to, set once at
  // creation (whether created from the Vendor Portal or by a Team Lead
  // who is themselves assigned to a vendor) and never changed afterwards
  // - see docs/09-BUSINESS-RULES.md "Vendor -> Team Lead -> Coder
  // Hierarchy". This is the authoritative pointer used to cascade a
  // Coder onto whichever Team Lead the Manager currently has assigned to
  // that vendor (User.teamId is updated to follow it); it exists because
  // a vendor-created Coder can be created before any Team Lead has been
  // assigned (teamId null) - team-derived vendor scope alone cannot cover
  // that case. Team Leads / Auditors continue to be linked to a vendor
  // through VendorAssignment, not this field.
  vendorId        String?
  vendor          Vendor?  @relation("VendorAccounts", fields: [vendorId], references: [id])

  // Set whenever the password changes; access/refresh tokens issued
  // before it are rejected (see LocalAuthProvider / JwtStrategy).
  passwordChangedAt DateTime?

  auditorAssignments AuditorProjectAssignment[]
  productionEntries  ProductionEntry[]           @relation("CoderProduction")
  auditEntries       AuditEntry[]                @relation("AuditorAudits")
  notifications      Notification[]
  activityLogs       ActivityLog[]
  auditLogs          AuditLog[]

  vendorsCreated           Vendor[]           @relation("VendorCreatedBy")
  vendorAssignments        VendorAssignment[] @relation("VendorAssignee")
  vendorAssignmentsMade    VendorAssignment[] @relation("VendorAssignedBy")
  vendorAssignmentsRemoved VendorAssignment[] @relation("VendorRemovedBy")
  reworksAsCoder           Rework[]           @relation("ReworkCoder")
  reworksAsAuditor         Rework[]           @relation("ReworkAuditor")
  reworksAsTeamLead        Rework[]           @relation("ReworkTeamLead")
  reworksResolved          Rework[]           @relation("ReworkResolvedBy")

  // Universal Approval Engine (docs/09-BUSINESS-RULES.md section 9) -
  // e.g. a Team Lead's Login Name change request for one of their Coders.
  approvalsAsTarget        ApprovalRequest[]  @relation("ApprovalTarget")
  approvalsRequested       ApprovalRequest[]  @relation("ApprovalRequestedBy")
  approvalsReviewed        ApprovalRequest[]  @relation("ApprovalReviewedBy")

  // Password Reset Request workflow (docs/09-BUSINESS-RULES.md section 8) -
  // a Vendor/Team Lead requests a reset for one of their own-scope Coders;
  // only a Manager can approve (generating a single-use reset link/token)
  // or reject it.
  passwordResetRequestsAsTarget  PasswordResetRequest[] @relation("PasswordResetTarget")
  passwordResetRequestsRequested PasswordResetRequest[] @relation("PasswordResetRequestedBy")
  passwordResetRequestsReviewed  PasswordResetRequest[] @relation("PasswordResetReviewedBy")
  passwordResetTokens            PasswordResetToken[]   @relation("PasswordResetTokenUser")

  // Login Name Allocation history (docs/09-BUSINESS-RULES.md section 10 /
  // Phase 9) - append-only record of every Login Name this user has ever
  // held. `loginNameAllocations` is this user's own history;
  // `loginNameAllocationsGranted`/`loginNameAllocationsRevoked` are the
  // Manager-side "who allocated/deallocated" audit trail.
  loginNameAllocations         LoginNameAllocation[] @relation("LoginNameAllocationUser")
  loginNameAllocationsGranted  LoginNameAllocation[] @relation("LoginNameAllocationAllocatedBy")
  loginNameAllocationsRevoked  LoginNameAllocation[] @relation("LoginNameAllocationDeallocatedBy")

  // Phase 10A/10B — Project<->Team assignment history and client chart
  // import provenance (docs/09-BUSINESS-RULES.md section 11).
  projectTeamAssignmentsMade   ProjectTeamAssignment[]      @relation("ProjectTeamAssignedBy")
  projectTeamAssignmentsRemoved ProjectTeamAssignment[]     @relation("ProjectTeamUnassignedBy")
  chartImportsMade             ChartImport[]                @relation("ChartImportImportedBy")
  chartImportTemplatesCreated  ChartImportTemplateVersion[] @relation("ChartImportTemplateCreatedBy")

  // Organization Assignment / Auto-Visibility requirement — append-only
  // Coder<->Team membership ledger (see TeamMembership below).
  // "AsCoder" is a Coder's own membership history; the rest are the
  // Team-Lead/Manager-side "who assigned/ended it" audit trail, mirroring
  // the ChartAllocation actor-relation pattern above.
  teamMembershipsAsCoder   TeamMembership[] @relation("TeamMembershipCoder")
  teamMembershipsAssigned  TeamMembership[] @relation("TeamMembershipAssignedBy")
  teamMembershipsEnded     TeamMembership[] @relation("TeamMembershipEndedBy")

  // Same requirement — AuditorProjectAssignment gains a soft-delete "who
  // removed it" actor column (see that model below); this is the
  // Manager-side audit trail of who ended an Auditor's Project assignment.
  auditorProjectAssignmentsRemoved AuditorProjectAssignment[] @relation("AuditorProjectAssignmentRemovedBy")

  // Phase 10D — Chart Allocation ledger (docs/09-BUSINESS-RULES.md section
  // 12). "AsCoder" is a Coder's own allocation history; the rest are the
  // Team-Lead/Manager-side audit trail of who allocated/ended/imported.
  chartAllocationsAsCoder    ChartAllocation[]       @relation("ChartAllocationCoder")
  chartAllocationsAsTeamLead ChartAllocation[]       @relation("ChartAllocationTeamLead")
  chartAllocationsAssigned   ChartAllocation[]       @relation("ChartAllocationAssignedBy")
  chartAllocationsEnded      ChartAllocation[]       @relation("ChartAllocationEndedBy")
  chartAllocationImportsMade ChartAllocationImport[] @relation("ChartAllocationImportedBy")
  chartsCurrentlyAssigned    Chart[]                 @relation("ChartCurrentCoder")
  chartsCurrentAssignedBy    Chart[]                 @relation("ChartCurrentAssignedBy")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // NOTE: no explicit @@index([employeeId]) / @@index([loginName]) here -
  // @unique already creates a B-tree index on each of those columns.
  // An additional @@index on the same single column would just be a
  // second, redundant index maintained on every write for no query
  // benefit - removed during the Phase 1 technical review.

  // Added for the Vendor -> Team Lead -> Coder cascade (Manager reassigns
  // a vendor's Team Lead -> every active Coder with this vendorId is
  // looked up and moved) - a real, hot query path once a vendor has any
  // meaningful number of Coders, so it earns its own index rather than
  // relying on a sequential scan.
  @@index([vendorId, role, isActive])
}

// ─────────────────────────────────────────────────────────────
// Teams, Clients, Projects
// ─────────────────────────────────────────────────────────────

model Team {
  id          String    @id @default(uuid())
  name        String
  teamLeadId  String?   @unique
  teamLead    User?     @relation("TeamLead", fields: [teamLeadId], references: [id])
  members     User[]    @relation("TeamMembers")
  projects    Project[]
  reworks     Rework[]
  createdAt   DateTime  @default(now())

  projectAssignments ProjectTeamAssignment[]
  chartAllocations   ChartAllocation[]
  memberships        TeamMembership[]
}

// Organization Assignment / Auto-Visibility requirement ("FINAL ORGANIZATION
// ASSIGNMENT + AUTO-VISIBILITY REQUIREMENT" section 1/9/11) — append-only
// history of which Team a Coder has belonged to, on top of the
// pre-existing User.teamId scalar. User.teamId is KEPT UNCHANGED and
// remains the single "current team" pointer every existing scope helper
// (chartScope/productionScope/etc.) and RBAC check reads - this table only
// ever ADDS a parallel, queryable membership history, mirroring the exact
// same pattern already used by ProjectTeamAssignment/VendorAssignment/
// ChartAllocation above. A partial unique index (see this model's
// migration - Prisma's schema DSL cannot express it) allows at most one
// ACTIVE membership per Coder, matching User.teamId's own "one team at a
// time" semantics - the same invariant, just made historically queryable
// and giving a Team Lead's "Relieve from Team" action a real row to close
// out rather than only clearing a scalar.
enum TeamMembershipEndReason {
  RELIEVED   // Team Lead's explicit "Relieve from Team" / "Release from Team" action.
  REASSIGNED // Coder moved onto a different Team (Manager reassignment, or the
             // Vendor -> Team Lead -> Coder cascade in VendorsService#assignTeamLead).
}

model TeamMembership {
  id     String @id @default(uuid())
  coderId String
  coder   User   @relation("TeamMembershipCoder", fields: [coderId], references: [id])
  teamId  String
  team    Team   @relation(fields: [teamId], references: [id])

  isActive     Boolean  @default(true)
  assignedAt   DateTime @default(now())
  assignedById String?
  assignedBy   User?    @relation("TeamMembershipAssignedBy", fields: [assignedById], references: [id])

  endedAt   DateTime?
  endedById String?
  endedBy   User?                    @relation("TeamMembershipEndedBy", fields: [endedById], references: [id])
  endReason TeamMembershipEndReason?

  @@index([coderId, isActive])
  @@index([teamId, isActive])
}

model Client {
  id       String    @id @default(uuid())
  name     String
  isActive Boolean   @default(true)
  projects Project[]
}

// Phase 10A: how a Project acquires its Charts. MANUAL = client-file-driven
// (see ChartImport below) - Charts are created by a Manager import, then
// distributed by the future Phase 10D Team-Lead-Summary-upload workflow.
// AUTOMATIC = today's existing (pre-Phase-10) behaviour: a Coder enters a
// Chart ID/Page Count directly in Production and the Chart is auto-created
// on first submission (see ProductionService.create) - completely
// unchanged by this phase.
//
// DEFAULT FOR EXISTING ROWS - this is a FACT, sourced below, not a guess:
// MANUAL did not exist as a concept before this migration, so AUTOMATIC is
// the only value that can be historically true of every pre-Phase-10
// Project - there is no ambiguity to resolve and nothing is being "silently
// converted". PROOF: `apps/api/src/modules/production/production.service.ts`
// (`if (!chart) await tx.chart.create(...)`) is, as of this migration, the
// ONLY Chart-creation code path that ever existed prior to this phase's own
// new ChartImportsService.commit (a repo-wide grep for chart.create/
// createMany/upsert confirms exactly these two call sites). That path is
// unconditional - it never branched on any project-level flag, because none
// existed - so every Chart on every existing Project was necessarily
// created by it. The migration backfills every existing row to AUTOMATIC
// explicitly (`NOT NULL DEFAULT 'AUTOMATIC'` - see this enum's
// migration.sql for the full sourced explanation), not merely relying on an
// unexplained schema default, and every current project's runtime
// behaviour is byte-for-byte identical after the migration (see "Chart
// Assignment" in docs/09-BUSINESS-RULES.md). AUTOMATIC is also the default
// applied to any newly-created Project that does not explicitly opt into
// MANUAL.
enum ProjectAllocationType {
  MANUAL
  AUTOMATIC
}

model Project {
  id             String                @id @default(uuid())
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id])
  teamId         String?
  team           Team?                 @relation(fields: [teamId], references: [id])
  name           String
  isActive       Boolean               @default(true)
  allocationType ProjectAllocationType @default(AUTOMATIC)

  charts              Chart[]
  auditorAssignments  AuditorProjectAssignment[]
  reworks             Rework[]
  teamAssignments     ProjectTeamAssignment[]
  chartImports        ChartImport[]
  // One Template per Project (see ChartImportTemplate below), created
  // lazily on that Project's first successful chart import.
  chartImportTemplate ChartImportTemplate?
  // Phase 10D — Manager Summary export / Team Lead allocation upload.
  chartAllocations       ChartAllocation[]
  chartAllocationImports ChartAllocationImport[]
}

// Phase 10A: append-only history of which Team has worked a Project, on
// top of the pre-existing Project.teamId scalar. Project.teamId is KEPT
// UNCHANGED and continues to be the single "current team" pointer every
// existing scope helper (chartScope/productionScope/auditScope/etc.) reads
// - this table only ever ADDS a parallel, queryable history of every
// assign/unassign transition, mirroring the VendorAssignment pattern
// above. A partial unique index (see this model's migration - Prisma's
// schema DSL cannot express it) allows at most one ACTIVE assignment per
// Project, matching Project.teamId's own "one team at a time" semantics.
model ProjectTeamAssignment {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id])
  teamId         String
  team           Team      @relation(fields: [teamId], references: [id])
  isActive       Boolean   @default(true)
  assignedAt     DateTime  @default(now())
  assignedById   String?
  assignedBy     User?     @relation("ProjectTeamAssignedBy", fields: [assignedById], references: [id])
  unassignedAt   DateTime?
  unassignedById String?
  unassignedBy   User?     @relation("ProjectTeamUnassignedBy", fields: [unassignedById], references: [id])

  @@index([projectId, isActive])
  @@index([teamId, isActive])
}

// Question 6 (docs/11-SCHEMA-DECISIONS.md) — Auditor scoped to Project(s),
// not to individually assigned charts.
//
// Organization Assignment / Auto-Visibility requirement section 13 - this
// used to be delete-on-unassign (ProjectsService#deleteAssignment ran a
// real DELETE), which lost history the moment an Auditor was unassigned.
// Additive, minimum-necessary fix: isActive/removedAt/removedById turn
// unassignment into a soft-delete (same shape as VendorAssignment/
// ProjectTeamAssignment above), so "historical assignments remain intact"
// holds for Auditors too. The old `@@unique([auditorId, projectId])` - which
// only worked because a delete freed the pair for reuse - is replaced by a
// partial unique index (see this table's migration; Prisma's schema DSL
// cannot express a partial index) allowing at most one ACTIVE assignment
// per (auditorId, projectId), so the same pair can be assigned, ended, and
// re-assigned later without ever losing the earlier row.
model AuditorProjectAssignment {
  id         String   @id @default(uuid())
  auditorId  String
  auditor    User     @relation(fields: [auditorId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  assignedAt DateTime @default(now())

  isActive    Boolean   @default(true)
  removedAt   DateTime?
  removedById String?
  removedBy   User?     @relation("AuditorProjectAssignmentRemovedBy", fields: [removedById], references: [id])

  @@index([auditorId, isActive])
  @@index([projectId, isActive])
}

// ─────────────────────────────────────────────────────────────
// Vendors
// ─────────────────────────────────────────────────────────────

// A Vendor is a scoped organisation under the Manager. Its data is the
// data of the Team Leads (their teams, coders, projects, charts,
// production, audits, rework) and Auditors assigned to it. Nothing is
// copied - scope is derived through VendorAssignment at query time.
model Vendor {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String   @unique
  contactName  String?
  contactEmail String?
  isActive     Boolean  @default(true)

  createdById  String?
  createdBy    User?    @relation("VendorCreatedBy", fields: [createdById], references: [id])

  accounts     User[]             @relation("VendorAccounts")
  assignments  VendorAssignment[]
  chartAllocations ChartAllocation[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Vendor -> Team Lead / Auditor. Removal ends the row (isActive=false,
// removedAt/By) instead of deleting it, so assignment history is kept.
// A partial unique index (raw SQL in the migration - not expressible in
// the Prisma DSL) allows at most ONE active assignment per user, which
// is what makes cross-vendor double assignment impossible.
model VendorAssignment {
  id          String    @id @default(uuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  userId      String
  user        User      @relation("VendorAssignee", fields: [userId], references: [id])
  role        RoleName
  isActive    Boolean   @default(true)
  assignedAt  DateTime  @default(now())
  assignedById String?
  assignedBy  User?     @relation("VendorAssignedBy", fields: [assignedById], references: [id])
  removedAt   DateTime?
  removedById String?
  removedBy   User?     @relation("VendorRemovedBy", fields: [removedById], references: [id])

  @@index([vendorId, isActive])
  @@index([userId, isActive])
}

// ─────────────────────────────────────────────────────────────
// Chart / Production / Audit — core business relationship
// ─────────────────────────────────────────────────────────────

enum ProductionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REWORK
  CANCELLED
}

enum AuditStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REVIEW_REQUIRED
  REJECTED
}

model Chart {
  id              String   @id @default(uuid())
  chartId         String   @unique
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id])

  // Phase 10D: the current-assignment convenience pointer these three
  // fields were reserved for since Phase 10A-10B (see
  // docs/11-SCHEMA-DECISIONS.md Question 5) - now wired up. This mirrors
  // sourceImportId's own role below: a cheap "who/when is this chart
  // assigned to right now" read, refreshed by every allocate/pullback/
  // reassign, but NEVER the source of truth for history - that is the
  // ChartAllocation ledger (see below). Null means "not currently
  // allocated" (never allocated yet, or pulled back and not reassigned).
  assignedCoderId String?
  assignedCoder   User?     @relation("ChartCurrentCoder", fields: [assignedCoderId], references: [id])
  assignedById    String?
  assignedByUser  User?     @relation("ChartCurrentAssignedBy", fields: [assignedById], references: [id])
  assignedAt      DateTime?

  allocations ChartAllocation[]

  // Phase 10A-10B (CORRECTED per architecture review): a pointer only, not
  // a copy of client data. The client-provided attribute VALUES (PageCount,
  // PageBucket, textbox9, EventTypeName2, High_Level_Status) are
  // deliberately NOT stored on Chart - they live in ChartImportRow below,
  // one new row per import that ever touches this ChartID, so:
  //   - a re-import of an already-imported ChartID NEVER overwrites or
  //     destroys a prior import's source values - every version is kept;
  //   - a Chart with real ProductionEntry/AuditEntry/Rework history is
  //     NEVER mutated by a later re-import - only a brand-new
  //     ChartImportRow is appended and this pointer is refreshed;
  //   - "where did this ChartID's data come from" is always answerable by
  //     walking ChartImportRow, never by trusting a single overwritten
  //     value on Chart itself.
  // sourceImportId is refreshed, each (re-)import, to point at the most
  // recent ChartImport that touched this Chart - a cheap, non-destructive
  // "current provenance" convenience pointer only; it is never the source
  // of truth for historical values (ChartImportRow is), and touching it
  // never writes to ProductionEntry/AuditEntry/Rework.
  sourceImportId String?
  sourceImport   ChartImport? @relation(fields: [sourceImportId], references: [id])

  productionEntries ProductionEntry[]
  reworks           Rework[]
  importRows        ChartImportRow[]
  createdAt         DateTime @default(now())

  @@index([assignedCoderId])
  @@index([sourceImportId])
}

// ─────────────────────────────────────────────────────────────
// Phase 10A-10B — Client File Driven Chart Import Foundation
// ─────────────────────────────────────────────────────────────
// See docs/09-BUSINESS-RULES.md section 11. The client sends a CSV/Excel
// file (the "Raw" sheet of their Allocation workbook); a Manager imports
// it into a MANUAL-allocation-type Project, which creates/updates real
// Chart rows. This is ONLY the import foundation - the later Team-Lead
// Summary-upload workflow ("Assigned to" -> Login Name -> Coder Production
// Space) is explicitly Phase 10D and is NOT implemented by these models.
//
// CORRECTED ARCHITECTURE (post-review): the intended lineage is
// Project -> Template -> TemplateVersion -> Import -> ImportRow -> Chart.
// A prior draft collapsed Template into TemplateVersion directly under
// Project; that has been undone below - ChartImportTemplate is now its own
// row (one per Project, created lazily on first import) and
// ChartImportTemplateVersion belongs to IT, not directly to Project. A new
// ChartImportRow model (also new, replacing the fields a prior draft had
// added straight onto Chart) is the actual source-of-truth for every
// imported row's client-provided values, keyed by (import, chart) - never
// updated in place, always inserted fresh, so full historical source data
// survives any number of repeated imports of the same ChartID.

enum ChartImportFileType {
  CSV
  XLSX
}

// PROCESSING is deliberately not a member of this enum: a commit's Chart/
// ChartImportRow writes (batched internally, up to CHART_IMPORT_MAX_ROWS
// per file) all happen inside ONE database transaction (see
// ChartImportsService.commit), so there is no intermediate state a client
// could ever observe between PENDING and the transaction's own resolution
// to COMPLETED or (on rollback) a separately-written FAILED row - adding a
// status nothing can ever read would be speculative, not descriptive.
enum ChartImportStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
}

// One Template per Project, created lazily on that Project's first
// successful import. Kept as its own row (not collapsed into
// TemplateVersion) so "the template identity for this project" and "one
// version of it" are two distinct, correctly-named concepts, matching the
// corrected Project -> Template -> TemplateVersion -> Import lineage the
// architecture review asked for.
model ChartImportTemplate {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())

  versions ChartImportTemplateVersion[]
}

// A version of its parent Template - a new version is only created when a
// Project's imported header set differs from its current active version,
// so historical imports/ChartImportRows keep a stable pointer to exactly
// the column layout that produced them.
model ChartImportTemplateVersion {
  id          String              @id @default(uuid())
  templateId  String
  template    ChartImportTemplate @relation(fields: [templateId], references: [id])
  version     Int
  headers     String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("ChartImportTemplateCreatedBy", fields: [createdById], references: [id])

  imports    ChartImport[]
  importRows ChartImportRow[]

  @@unique([templateId, version])
  @@index([templateId, isActive])
}

// The Import History record required by docs/09-BUSINESS-RULES.md section
// 11 - one row per import attempt (preview never creates one; only a
// commit does), always written in the SAME transaction as the
// Chart/ChartImportRow writes it produces, so status can never be
// COMPLETED while the writes it describes did not actually happen (see
// ChartImportsService).
model ChartImport {
  id                String              @id @default(uuid())
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id])
  templateVersionId String?
  templateVersion   ChartImportTemplateVersion? @relation(fields: [templateVersionId], references: [id])

  fileName String
  fileType ChartImportFileType
  status   ChartImportStatus @default(PENDING)

  totalRows     Int @default(0)
  validRows     Int @default(0)
  invalidRows   Int @default(0)
  duplicateRows Int @default(0)
  successRows   Int @default(0)
  failedRows    Int @default(0)

  // A capped list of row-level validation messages (never the raw file
  // contents, never full row dumps) - enough for the Manager to see what
  // went wrong without persisting client PHI/PII-adjacent data twice.
  errorSummary Json?

  importedById String?
  importedBy   User?    @relation("ChartImportImportedBy", fields: [importedById], references: [id])
  importedAt   DateTime @default(now())

  chartsTouched Chart[]
  rows          ChartImportRow[]

  @@index([projectId, importedAt])
  @@index([status])
}

// NEW (architecture-review correction): the actual per-row source-of-truth
// for a client-imported chart's attribute values - one row per (import,
// chart) pair, INSERT-only, never updated or overwritten. Re-importing an
// already-imported ChartID appends a brand-new row here rather than
// mutating anything on Chart, so:
//   - every historical set of client-provided values for a ChartID is kept
//     forever, even across repeated imports with changed values;
//   - a Chart's ProductionEntry/AuditEntry/Rework history is never at risk
//     of being touched by a later re-import, because this table has no
//     relation to any of them;
//   - "where did ChartID X come from" is answered precisely: this row's
//     chartImport (project/file/importedBy/importedAt) + templateVersion.
model ChartImportRow {
  id String @id @default(uuid())

  chartImportId String
  chartImport   ChartImport @relation(fields: [chartImportId], references: [id])

  templateVersionId String
  templateVersion   ChartImportTemplateVersion @relation(fields: [templateVersionId], references: [id])

  // References Chart.chartId (not Chart.id), mirroring the existing
  // ProductionEntry->Chart relation pattern already used elsewhere in this
  // schema.
  chartId String
  chart   Chart  @relation(fields: [chartId], references: [chartId])

  rowNumber Int

  pageCount       Int
  pageBucket      String?
  textbox9        String?
  eventTypeName2  String?
  highLevelStatus String?

  createdAt DateTime @default(now())

  @@index([chartImportId])
  @@index([chartId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Phase 10D — Chart Allocation (Manager Summary export -> Team Lead
// Login-Name allocation upload -> Coder Production visibility)
// ─────────────────────────────────────────────────────────────
// See docs/09-BUSINESS-RULES.md section 12. For a MANUAL-allocation-type
// Project, Charts exist (via Phase 10A/10B's client Raw import) before any
// Coder is assigned to them. This phase adds the actual Manager -> Team
// Lead -> Coder assignment step: the Manager exports a filtered Summary of
// a Project's charts (client columns + a blank "Assigned to" + a fixed
// "Shift 1"), the Team Lead fills in each row's "Assigned to" with a
// Coder's Login Name and re-uploads it, and SmartCode validates + commits
// one ChartAllocation row per Chart - the actual, queryable, append-only
// ledger the Chart.assignedCoderId/assignedById/assignedAt scalars above
// (reserved since Phase 10A-10B) were always meant to summarize. Those
// three Chart scalars remain the cheap "current assignment" pointer
// (mirroring Chart.sourceImportId's own role for ChartImportRow) - this
// table is the source of truth for history; the pointer is refreshed by
// every allocate/pullback/reassign, never the other way around.

// Import History record for a Team Lead's Summary upload, mirroring
// ChartImport's shape/lifecycle exactly (same file-type/status enums,
// reused rather than duplicated - a second all-or-nothing, one-file-one-
// transaction import workflow, not a conceptually different one; see
// ChartAllocationsService.commitAllocationUpload).
model ChartAllocationImport {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  fileName String
  fileType ChartImportFileType
  status   ChartImportStatus @default(PENDING)

  totalRows     Int @default(0)
  validRows     Int @default(0)
  invalidRows   Int @default(0)
  duplicateRows Int @default(0)
  successRows   Int @default(0)
  failedRows    Int @default(0)

  // Same rationale as ChartImport.errorSummary above - a capped list of
  // row-level validation messages, never raw file contents.
  errorSummary Json?

  importedById String?
  importedBy   User?    @relation("ChartAllocationImportedBy", fields: [importedById], references: [id])
  importedAt   DateTime @default(now())

  allocations ChartAllocation[]

  @@index([projectId, importedAt])
  @@index([status])
}

// Reason an allocation row was closed out. Reassignment and pullback are
// distinct operations with distinct consequences (a reassignment always
// creates a brand-new active row for a different Coder in the same
// transaction; a pullback leaves the Chart unassigned until the next
// Summary upload or an explicit reassignment) - kept as a real enum, not
// free-text, so the ledger can be queried/reported on precisely.
enum ChartAllocationEndReason {
  PULLED_BACK
  REASSIGNED
}

// The actual append-only allocation ledger. A partial unique index (raw
// SQL - see this table's migration; Prisma's schema DSL cannot express a
// partial index) enforces "at most one ACTIVE allocation per chartId",
// mirroring the exact same pattern already used for ProjectTeamAssignment/
// VendorAssignment/LoginNameAllocation above.
model ChartAllocation {
  id String @id @default(uuid())

  // References Chart.chartId (business key), matching the established
  // pattern already used by ProductionEntry/Rework/ChartImportRow above.
  chartId String
  chart   Chart  @relation(fields: [chartId], references: [chartId])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  coderId String
  coder   User   @relation("ChartAllocationCoder", fields: [coderId], references: [id])

  // Snapshot of the Coder's Login Name at allocation time - the Team
  // Lead's Summary upload is keyed by Login Name (an auditable allocation
  // identity per docs/09-BUSINESS-RULES.md section 10 / Phase 9), and a
  // later Login Name change must never rewrite what this historical row
  // says was actually typed into the upload - mirrors
  // LoginNameAllocation.employeeId's own "snapshot, not a live join"
  // rationale above.
  loginNameSnapshot String

  // The Coder's Vendor/Team at allocation time, snapshotted for the same
  // reason as loginNameSnapshot - a later team/vendor change must not
  // rewrite what this row says was actually validated and allocated.
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  teamId   String?
  team     Team?   @relation(fields: [teamId], references: [id])

  teamLeadId String?
  teamLead   User?  @relation("ChartAllocationTeamLead", fields: [teamLeadId], references: [id])

  assignedById String
  assignedBy   User     @relation("ChartAllocationAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  sourceImportId String?
  sourceImport   ChartAllocationImport? @relation(fields: [sourceImportId], references: [id])

  isActive Boolean @default(true)

  endedAt   DateTime?
  endedById String?
  endedBy   User?                     @relation("ChartAllocationEndedBy", fields: [endedById], references: [id])
  endReason ChartAllocationEndReason?
  // Optional free-text context for a pullback (e.g. "wrong coder", "coder
  // on leave") - docs/09-BUSINESS-RULES.md section 12 item "reason where
  // applicable". Reassignment's "reason" is implicit in endReason plus the
  // nextAllocation it links to, so this is populated only for PULLED_BACK.
  endNote   String?

  // Reassignment chain - the row this one replaced (null for a chart's
  // very first allocation). Lets the ledger answer "what was this chart
  // reassigned FROM" without scanning by chartId+assignedAt ordering.
  previousAllocationId String?          @unique
  previousAllocation   ChartAllocation? @relation("ChartAllocationChain", fields: [previousAllocationId], references: [id])
  nextAllocation       ChartAllocation? @relation("ChartAllocationChain")

  @@index([chartId, isActive])
  @@index([coderId, isActive])
  @@index([projectId, isActive])
  @@index([teamId, isActive])
}

// Versioned per docs/11-SCHEMA-DECISIONS.md Question 1 (approved):
// a Chart may have multiple ProductionEntry versions; exactly one
// is current at any time. Rework creates a new version rather than
// mutating a COMPLETED record — see docs/09-BUSINESS-RULES.md.
model ProductionEntry {
  id         String           @id @default(uuid())
  chartId    String
  chart      Chart            @relation(fields: [chartId], references: [chartId])
  coderId    String
  coder      User             @relation("CoderProduction", fields: [coderId], references: [id])

  version    Int              @default(1)
  isCurrent  Boolean          @default(true)

  pageCount  Int
  totalDOS   Int
  totalICDs  Int
  status     ProductionStatus @default(PENDING)
  remarks    String?
  codedDate  DateTime

  auditEntries AuditEntry[]
  reworksFromThisVersion Rework[] @relation("ReworkOriginalProduction")
  reworkOf               Rework?  @relation("ReworkProduction")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([chartId, version])
  @@index([coderId])
  @@index([codedDate])
  // NOTE: a partial unique index enforcing exactly one isCurrent=true row
  // per chartId is added via a raw SQL migration (Postgres partial indexes
  // are not expressible in the Prisma schema DSL) — see
  // prisma/migrations/.../migration.sql and docs/02-DATABASE-DESIGN.md.
}

// 1:N against ProductionEntry per docs/11-SCHEMA-DECISIONS.md Question 3
// (approved): supports re-audit without restructuring. v1 business logic
// constrains this to one active audit per version; a second row is only
// created after the first's status is REJECTED — enforced in the service
// layer (see docs/09-BUSINESS-RULES.md "Audit Resolution & Re-audit").
model AuditEntry {
  id                String          @id @default(uuid())
  productionEntryId String
  productionEntry   ProductionEntry @relation(fields: [productionEntryId], references: [id])
  // Deliberately NOT a @relation/foreign key to Chart - this is a read-path
  // denormalization only (see docs/04-API-ARCHITECTURE.md "GET
  // /charts/:chartId/audit-history"). Referential integrity for which
  // chart an audit belongs to is enforced transitively through
  // productionEntryId -> ProductionEntry.chartId, which IS a real FK.
  // A stale/mismatched chartId here would be an application bug, not
  // something the database schema itself can catch - flagged as a known
  // trade-off, not an oversight.
  chartId           String
  auditorId         String
  auditor           User            @relation("AuditorAudits", fields: [auditorId], references: [id])

  auditErrors       Int
  errorExceptions   Int
  totalErrors       Int             // recomputed server-side on every write — see docs/06
  status            AuditStatus     @default(PENDING)
  auditDate         DateTime
  remarks           String?

  reworkRequest     Rework?         @relation("ReworkAudit")
  reworkReaudits    Rework[]        @relation("ReworkReaudit")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([productionEntryId])
  @@index([chartId])
  @@index([auditorId])
  @@index([auditDate])
}

// ─────────────────────────────────────────────────────────────
// Rework (Auditor "Rework" decision -> Coder correction -> re-audit)
// ─────────────────────────────────────────────────────────────

enum ReworkStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REAUDITED
  WITHDRAWN
}

// One row per rejected audit that sent a chart back to the Coder. Links
// the chart, the rejected audit, the audited production version, the
// corrected version, and the people/team/project at the time of the
// decision. The rejected audit and audited version are never modified.
model Rework {
  id                   String          @id @default(uuid())
  chartId              String
  chart                Chart           @relation(fields: [chartId], references: [chartId])
  auditEntryId         String          @unique
  auditEntry           AuditEntry      @relation("ReworkAudit", fields: [auditEntryId], references: [id])
  originalProductionId String
  originalProduction   ProductionEntry @relation("ReworkOriginalProduction", fields: [originalProductionId], references: [id])
  reworkProductionId   String?         @unique
  reworkProduction     ProductionEntry? @relation("ReworkProduction", fields: [reworkProductionId], references: [id])
  reauditEntryId       String?
  reauditEntry         AuditEntry?     @relation("ReworkReaudit", fields: [reauditEntryId], references: [id])

  coderId              String
  coder                User            @relation("ReworkCoder", fields: [coderId], references: [id])
  auditorId            String
  auditor              User            @relation("ReworkAuditor", fields: [auditorId], references: [id])
  teamId               String?
  team                 Team?           @relation(fields: [teamId], references: [id])
  teamLeadId           String?
  teamLead             User?           @relation("ReworkTeamLead", fields: [teamLeadId], references: [id])
  projectId            String
  project              Project         @relation(fields: [projectId], references: [id])

  reason               String
  status               ReworkStatus    @default(OPEN)
  resolutionNote       String?
  resolvedAt           DateTime?
  resolvedById         String?
  resolvedBy           User?           @relation("ReworkResolvedBy", fields: [resolvedById], references: [id])
  reauditedAt          DateTime?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status])
  @@index([coderId, status])
  @@index([teamId, status])
  @@index([auditorId, status])
  @@index([chartId])
  @@index([originalProductionId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Notifications & Logging
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  isRead    Boolean  @default(false)
  // What the notification is about (e.g. entity "Rework" + its id), so the
  // UI can link to it and the same event can never notify a user twice.
  entity    String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, type, entityId])
  @@index([userId])
  @@index([userId, isRead])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

// Compliance-grade, append-only log — see docs/07-SECURITY-ARCHITECTURE.md.
// No DELETE endpoint exists for this model at the application layer.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  role      String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@index([action])
  @@index([timestamp])
}

// ─────────────────────────────────────────────────────────────
// Universal Approval Engine
// ─────────────────────────────────────────────────────────────
// docs/09-BUSINESS-RULES.md section 9: a Team Lead cannot directly finalize
// a Coder's Login Name change - they REQUEST it, a Manager must Approve or
// Reject it, and only an Approve applies the change. Deliberately generic
// (type + a free-form payload) rather than a Login-Name-specific table, so
// any future "request now, approve later" workflow reuses this one engine
// instead of a second, competing approval mechanism.

enum ApprovalType {
  LOGIN_NAME_CHANGE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id     String         @id @default(uuid())
  type   ApprovalType
  status ApprovalStatus @default(PENDING)

  // The user the request is about (e.g. the Coder whose Login Name would
  // change) - distinct from requestedBy, who acts on the target's behalf.
  targetUserId String
  targetUser   User   @relation("ApprovalTarget", fields: [targetUserId], references: [id])

  requestedById String
  requestedBy   User     @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  // Type-specific detail, e.g. { currentLoginName, requestedLoginName } for
  // LOGIN_NAME_CHANGE - keeps this table schema-generic across types.
  payload Json

  reviewedById    String?
  reviewedBy      User?     @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The list a Manager works from is "pending requests of this type",
  // and a target/requester's own history is looked up almost as often.
  @@index([type, status])
  @@index([targetUserId])
  @@index([requestedById])
}

// ─────────────────────────────────────────────────────────────
// Password Reset Request (docs/09-BUSINESS-RULES.md section 8)
// ─────────────────────────────────────────────────────────────
// A Vendor/Team Lead can no longer directly reset a Coder's password (see
// UsersService.resetPassword, still used by the Manager only, directly).
// Instead they REQUEST a reset; only a Manager can Approve (which
// generates a single-use, time-limited PasswordResetToken and returns the
// reset URL once) or Reject it (no token is ever generated). This is a
// dedicated model rather than a new ApprovalRequest type because it needs
// its own child table (PasswordResetToken) with its own lifecycle
// (expiry/used/invalidated) that a generic JSON payload cannot express.

enum PasswordResetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model PasswordResetRequest {
  id     String                     @id @default(uuid())
  status PasswordResetRequestStatus @default(PENDING)

  // The account whose password would be reset - a Coder, in every case
  // this phase's request-side authorization allows (see
  // PasswordResetService.request).
  targetUserId String
  targetUser   User   @relation("PasswordResetTarget", fields: [targetUserId], references: [id])

  requestedById String
  requestedBy   User     @relation("PasswordResetRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())
  reason        String?

  reviewedById    String?
  reviewedBy      User?     @relation("PasswordResetReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  // Normally at most one token per request (created on Approve), but kept
  // as a relation rather than 1:1 fields so a future re-issue/resend never
  // needs a schema change - only the "one live token" invariant, enforced
  // in the service layer.
  tokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The Manager's queue is "pending requests"; a target/requester's own
  // history is looked up almost as often.
  @@index([status])
  @@index([targetUserId])
  @@index([requestedById])
}

model PasswordResetToken {
  id String @id @default(uuid())

  requestId String
  request   PasswordResetRequest @relation(fields: [requestId], references: [id])

  userId String
  user   User   @relation("PasswordResetTokenUser", fields: [userId], references: [id])

  // ONLY a SHA-256 hash of the cryptographically random raw token is ever
  // stored - see apps/api/src/common/reset-token.ts. The raw token exists
  // only long enough to build the URL returned once, to the Manager, at
  // Approve time; it is never persisted, logged, or returned again.
  tokenHash String @unique

  expiresAt     DateTime
  usedAt        DateTime?
  invalidatedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([requestId])
}

// Login Name Allocation history (docs/09-BUSINESS-RULES.md section 10 /
// Phase 9). A Login Name is an auditable ALLOCATION identity, not just a
// mutable User column: SmartCode must be able to say, for any Login Name,
// who holds it now, who held it before, and exactly when it changed
// hands - this model is that append-only ledger. User.loginName remains
// the single source of truth for authentication (unchanged); this table
// only ever gains rows, it never drives login itself.
//
// INVARIANTS (enforced at the database level, not just in the service
// layer - see this model's migration for the two PARTIAL UNIQUE INDEXES
// Prisma's schema DSL cannot express directly):
//   1. At most one ACTIVE allocation per loginName at any time.
//   2. At most one ACTIVE allocation per userId at any time.
// Reassignment NEVER updates or deletes a row: the old ACTIVE row is
// closed out (status -> REALLOCATED, deallocatedAt/deallocatedById set)
// and a brand-new ACTIVE row is created, in one transaction alongside the
// User.loginName update itself - see LoginNameAllocationService.reallocate
// and UsersService.changeLoginName.
//
// Deliberately does NOT snapshot the user's role/vendor/team/team-lead at
// allocation time (only `employeeId`, which is itself a stable identity,
// is kept alongside `loginName`) - the spec's minimum field list does not
// call for point-in-time org snapshots, so Login Name Details/Employee
// Directory join to the user's CURRENT organizational placement. A
// historical row's loginName + employeeId is enough to identify exactly
// who held it and when; only the "where were they placed at the time"
// detail is not preserved, and is disclosed as a known limitation.
enum LoginNameAllocationStatus {
  ACTIVE
  DEACTIVATED
  REALLOCATED
}

model LoginNameAllocation {
  id String @id @default(uuid())

  loginName String
  userId    String
  user      User   @relation("LoginNameAllocationUser", fields: [userId], references: [id])

  // Kept alongside loginName/userId (rather than looked up live from
  // User) so a historical row always identifies who it belonged to even
  // if the User row's own employeeId were ever changed later.
  employeeId String

  status LoginNameAllocationStatus @default(ACTIVE)

  allocatedAt   DateTime  @default(now())
  deallocatedAt DateTime?

  // Nullable, mirroring AuditLog.userId's own established "no human actor
  // recorded" convention (see AuditLog model above) - never falsely
  // attributed to the account holder themselves and never a fabricated
  // Manager. Null only for pre-Phase-9 accounts created by the one-time
  // backfill (apps/api/scripts/backfill-login-name-allocations.ts), whose
  // `reason` field explicitly marks them as an INITIAL_BACKFILL,
  // system-origin allocation. Every allocation a real Manager creates or
  // reallocates through UsersService.changeLoginName /
  // ApprovalsService.approve always has a real allocatedById.
  allocatedById String?
  allocatedBy   User?   @relation("LoginNameAllocationAllocatedBy", fields: [allocatedById], references: [id])

  deallocatedById String?
  deallocatedBy   User?   @relation("LoginNameAllocationDeallocatedBy", fields: [deallocatedById], references: [id])

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Non-unique indexes for query performance (search/filter/history
  // lookups) - the two UNIQUE, PARTIAL (WHERE status = 'ACTIVE') indexes
  // that actually enforce the "one ACTIVE per loginName"/"one ACTIVE per
  // userId" invariants live in this model's migration.sql, since Prisma's
  // schema DSL has no syntax for a partial index.
  @@index([loginName])
  @@index([userId])
  @@index([status])
}
